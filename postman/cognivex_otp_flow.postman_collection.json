			"value": "",
			"type": "string"
		},
		{
			"key": "test_email",
			"value": "",
			"type": "string"
		},
		{
			"key": "test_password",
			"value": "",
			"type": "string"
		},
		{
			"key": "supabase_url",
			"value": "",
